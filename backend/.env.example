# Zet op false zodra jullie Teamleader-marketplace-app + Postgres-database klaar staan.
MOCK_MODE=true

PORT=4000

# Te verkrijgen via https://marketplace.focus.teamleader.eu/build (registreer een private integratie)
TEAMLEADER_CLIENT_ID=
TEAMLEADER_CLIENT_SECRET=
TEAMLEADER_REDIRECT_URI=http://localhost:4000/oauth/callback

# Publiek bereikbare basis-URL van deze backend (voor OAuth-redirect en webhook-registratie)
PUBLIC_BASE_URL=http://localhost:4000

# Willekeurige, geheime string — gebruikt als pad-segment in de webhook-URL
# (bv. https://.../webhooks/teamleader/<WEBHOOK_SECRET_PATH>) zodat enkel Teamleader
# (die deze URL van jullie kreeg) er events naartoe kan sturen.
WEBHOOK_SECRET_PATH=

DATABASE_URL=postgres://user:password@localhost:5432/ecofinity_cockpit

POLL_INTERVAL_MINUTES=15
